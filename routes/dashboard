const express = require("express");
const auth = require("../middleware/authMiddleware");
const Task = require("../models/Task");

const router = express.Router();

router.get("/", auth, async (req, res) => {
  try {
    const userId = req.user.id;

    const myTasks = await Task.countDocuments({ userId });
    const incomingRequests = 0; // Future milestone
    const myRequests = 0;       // Future milestone

    res.json({
      nav: ["Feed", "My Tasks", "Requests", "My Requests", "Add Task", "Settings"],
      stats: { myTasks, incomingRequests, myRequests }
    });
  } catch (err) {
    res.status(500).json({ error: "Server error" });
  }
});

module.exports = router;
